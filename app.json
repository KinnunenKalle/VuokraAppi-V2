{
  "expo": {
    "name": "VuokraAppi",
    "slug": "vuokraappi",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vuokraappi.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f8fafc"
      },
      "package": "com.vuokraappi.app"
    },
    "scheme": "vuokraappi",
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font"
    ]
  }
}
